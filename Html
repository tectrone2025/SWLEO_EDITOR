<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>SWLEO EDITOR</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      margin: 0;
      padding: 0;
      transition: background 0.3s, color 0.3s;
    }

    .container {
      margin-top: 100px;
    }

    h1 {
      font-size: 3em;
      margin-bottom: 40px;
    }

    input[type="text"] {
      padding: 10px;
      font-size: 1em;
      width: 200px;
      margin-bottom: 20px;
    }

    select {
      padding: 10px;
      font-size: 1em;
      margin-bottom: 20px;
    }

    button {
      padding: 10px 20px;
      font-size: 1em;
      cursor: pointer;
    }

    /* Light and Dark Mode Styles */
    body.light {
      background-color: #f5f5f5;
      color: #333;
    }

    body.dark {
      background-color: #121212;
      color: #f5f5f5;
    }
  </style>
</head>
<body class="light">
  <div class="container">
    <h1>SWLEO EDITOR</h1>
    <input type="text" id="username" placeholder="Enter your username" required><br>
    <select id="modeSelect">
      <option value="light">Light Mode</option>
      <option value="dark">Dark Mode</option>
    </select><br>
    <button onclick="startEditing()">Start Editing</button>
  </div>

  <script>
    // Change theme based on selection
    const modeSelect = document.getElementById('modeSelect');
    modeSelect.addEventListener('change', () => {
      document.body.className = modeSelect.value;
    });

    // Start Editing
    function startEditing() {
      const username = document.getElementById('username').value;
      if (!username) {
        alert("Please enter your username!");
        return;
      }
      alert(`Welcome ${username}! SWLEO EDITOR is ready.`);
      // Here you can redirect to editor page later
      // window.location.href = "editor.html";
    }
  </script>
</body>
</html>
